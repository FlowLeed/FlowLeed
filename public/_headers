# Response headers for Cloudflare static assets (Vite copies this file into dist/).
# Files in /assets/ have a content hash in their name, so they never change and can be cached for a year.
# Everything else, including index.html and sw-push.js, keeps Cloudflare's default (revalidate on each visit).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
