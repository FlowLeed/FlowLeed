// Cloudflare Workers static-assets hosting for the Vite build in dist/.
// CI deploys staging with `wrangler deploy --env staging` (see DEPLOYMENT.md).
// Deploying without --env would create the production Worker "flowleed", which isn't set up yet.
{
  "name": "flowleed",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes such as /contacts/123.
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      // Deployed as the Worker "flowleed-staging" at https://flowleed-staging.<account-subdomain>.workers.dev.
      // To serve it on your own domain, add: "routes": [{ "pattern": "staging.example.com", "custom_domain": true }]
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
